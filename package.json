{
  "name": "bruno-steiger-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "npm run quality && gh-pages -d out",
    "lint": "biome check app components data lib tests scripts",
    "format": "biome format --write app components data lib tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:commits": "commitlint --from HEAD~1 --to HEAD",
    "check:unused": "knip",
    "quality": "npm run lint && npm run check:architecture && npm run test && npm run build",
    "quality:full": "npm run quality && npm run test:e2e && npm run check:unused"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "latest",
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "knip": "^6.36.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
